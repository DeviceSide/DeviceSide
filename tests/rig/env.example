# Copy to .env.rig at the repo root (gitignored). Read by scripts/rig.py.
# HA_TOKEN: a long-lived token for a NON-admin user; the rig only calls services and reads states.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# HA_ADMIN_TOKEN: an admin user's token, for ZHA and Zigbee2MQTT suites (admin-only cluster command, MQTT) and
# for setting deviceside's options for suites whose adapter has them (Hue brightness raise, lower and stop).
HA_ADMIN_TOKEN=
# Full shell commands for your deploy tooling. These are not in the repo.
# RIG_SYNC_CMD: syncs the pushed branch into the rig and replaces the installed integration by renaming a complete
#   copy over it, so HA never imports a half-copied tree.
# RIG_STATUS_CMD: prints `synced <tree>` (the tree on disk) and `loaded <tree>` (the tree HA last restarted onto),
#   one per line; exits 91 if never synced. A single bare hash, from older tooling, counts as both.
# RIG_RESTART_CMD: restarts Home Assistant, and records the synced tree as loaded only if the restart succeeds.
RIG_SYNC_CMD=
RIG_STATUS_CMD=
RIG_RESTART_CMD=
# HUE_BRIDGE_HOST, HUE_APP_KEY: the Hue bridge's address and an application key, for the `bridge` step, which writes
# to the bridge behind Home Assistant's back. Only a run of a Hue step file that uses `bridge` needs them.
HUE_BRIDGE_HOST=
HUE_APP_KEY=
# RIG_BLOCKER_ENTITY: an HA binary_sensor that is on while someone might see the lights move (say, a template on the
#   household's phones and cars). Set, unattended runs and probes go only while it is off and abort when it turns
#   on, unless the profile has `pre_authorized: true`; a yes typed at the prompt overrides it. Empty, nothing gates on
#   it. Example: binary_sensor.rig_blocker
RIG_BLOCKER_ENTITY=
